# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# LLM Provider: claude | ollama | openai
#   claude → Anthropic (paid, best quality)
#   ollama → local open-source models (free, only works where Ollama is running)
#   openai → OpenAI OR any OpenAI-compatible API via OPENAI_BASE_URL (see below)
LLM_PROVIDER=claude
CLAUDE_API_KEY=sk-ant-your-key
OPENAI_API_KEY=sk-your-key
# OPENAI_BASE_URL points the "openai" provider at any OpenAI-compatible endpoint.
# Blank = real OpenAI. To serve open-source models via Together AI:
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://api.together.xyz/v1
#   OPENAI_API_KEY=<your Together key from https://api.together.ai>
#   OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   OPENAI_VISION_MODEL=meta-llama/Llama-3.2-90B-Vision-Instruct-Turbo
# The same three variables work for OpenRouter, Fireworks, a self-hosted vLLM
# server, etc. — only the URL and model id change.
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# Model overrides (optional — defaults shown)
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_VISION_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
# Open-source models served by Ollama. Pull first, e.g.:
#   ollama pull llama3.1
#   ollama pull llava
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava

# Embeddings (local, free, runs on CPU)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Voice / speech-to-text provider: openai | local
# "local" uses faster-whisper offline (pip install faster-whisper)
VOICE_PROVIDER=openai
LOCAL_WHISPER_MODEL=base

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
# "embedded" (default) = in-process, stores vectors on disk at CHROMA_PERSIST_DIR,
#                        no separate server needed. Use this for local + portfolio deploy.
# "http" = connect to a standalone `chroma run` server on CHROMA_HOST:CHROMA_PORT.
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Dev database: true = in-memory (seed accounts, resets on restart — perfect for a
# free portfolio demo with no external DB). false = use the real Supabase above.
USE_DEV_DB=true

# JWT
JWT_SECRET=your-jwt-secret-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Abuse protection for the PUBLIC chat endpoints (no login required, since the
# embeddable widget must work for anonymous site visitors). Uses Redis if
# REDIS_URL above is reachable, otherwise an in-process counter — no extra
# service required either way. Raise/lower to fit your traffic.
RATE_LIMIT_PER_MINUTE=20     # max chat requests per visitor IP per 60s
BOT_DAILY_MESSAGE_LIMIT=300  # max AI replies per bot per UTC day

# WhatsApp
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Instagram
INSTAGRAM_TOKEN=your-instagram-token
INSTAGRAM_VERIFY_TOKEN=your-ig-verify-token

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Email
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# App
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
ENVIRONMENT=development
