# Base URL of the Lumio backend API (no trailing slash, no /api suffix).
#
# The WebSocket URL for the agent inbox is derived from this automatically
# (http -> ws, https -> wss), and auth is handled by the backend's own JWT —
# there are no Supabase keys to configure on the frontend.
VITE_API_URL=http://localhost:8000

# Optional demo account. When VITE_DEMO_EMAIL is set, the login page shows a
# one-click "Explore the live demo" button so a visitor (recruiter, prospective
# client) never has to guess credentials. Leave BOTH unset on a real client
# deployment and the button is not rendered at all.
#
# These are inlined into the bundle at BUILD time, so changing them needs a
# rebuild — not just a restart. Only ever point them at a throwaway sandbox
# account; never a real one.
#
# Matches the dev-DB seed account (see backend/app/dev_db.py):
VITE_DEMO_EMAIL=admin@botforge.dev
VITE_DEMO_PASSWORD=admin123
