# Caddy config for serving the built Lumio dashboard (a Vite SPA) on Railway.
# Based on Railway's official React deployment guide.

{
	admin off          # no need for the admin API in Railway's environment
	persist_config off # storage isn't persistent anyway
	auto_https off     # Railway terminates TLS for us; enabling this breaks it

	log {
		format json
	}

	servers {
		# Trust Railway's proxy so client IPs in logs are real.
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

# Railway injects $PORT; fall back to 3000 for local `docker run`.
:{$PORT:3000} {
	log {
		format json
	}

	root * /srv
	encode gzip
	file_server

	# The dashboard is a client-side-routed SPA (React Router). Without this,
	# deep links and refreshes on routes like /dashboard or /bots/:id would
	# 404, because no such file exists on disk — every unmatched path has to
	# fall back to index.html so the router can handle it. This is the Caddy
	# equivalent of the rewrite already in frontend/vercel.json.
	try_files {path} /index.html
}
